# ===================================
# KEEP THESE FILES (override patterns above)
# ===================================

# Important documentation
!README.md
!*.md
!NETCDF_VIEWING_GUIDE.md
!Internal_Wave_*.md

# Configuration templates
!config_template.py
!swot_config.py

# Example notebooks
!nc_file_viewer_guide.ipynb
!SWOT_Data_Analysis.ipynb
!graph.ipynb
!swotdata.ipynb
!swot_data_new.ipynb

# Core analysis scripts
!swot_data_analysis.py
!netcdf_analysis_workflow.py
!swot_internal_wave_visualizer.py
!simple_nc_examples.py

